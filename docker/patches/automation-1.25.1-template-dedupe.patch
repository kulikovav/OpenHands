+def template_matches(
+    preset_metadata: dict[str, Any] | None,
+    template: TemplateProvenance,
+) -> bool:
+    """Whether stored provenance describes the same template setup.
+
+    ``template.id`` is the catalog entry; ``template.config`` is the setup the
+    user chose for one automation of it. An id-only match made a second setup
+    impossible: a new project, label or schedule returned the first automation.
+    ``version`` stays out of the identity, because a version bump describes the
+    same setup from a newer catalog and must keep pointing at its automation.
+    """
+    stored = (preset_metadata or {}).get("template")
+    if not isinstance(stored, dict):
+        return False
+    if stored.get("id") != template.id:
+        return False
+    return (stored.get("config") or {}) == (template.config or {})
+

+def dispatch_capacity(running: int, max_running: int, batch_size: int) -> int:
+    """Return how many pending runs the dispatcher may start now.
+
+    A ``max_running`` of 0 or less keeps the upstream behavior: the whole
+    batch starts. A positive ceiling leaves the surplus runs PENDING, so the
+    backlog queues in the database until an in-flight run finishes.
+    """
+    if max_running <= 0:
+        return batch_size
+    return max(0, min(batch_size, max_running - running))
+
